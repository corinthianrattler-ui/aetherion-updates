{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aetherion Update Manifest",
  "type": "object",
  "required": ["schema", "channel", "enabled", "latest", "payloads"],
  "properties": {
    "schema": {"type": "integer", "minimum": 1},
    "channel": {"type": "string"},
    "enabled": {"type": "boolean"},
    "latest": {
      "type": "object",
      "required": ["game_version", "android_version_code"],
      "properties": {
        "game_version": {"type": "string"},
        "android_version_code": {"type": "integer", "minimum": 1},
        "min_updater_schema": {"type": "integer", "minimum": 1}
      }
    },
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "url", "sha256", "size"],
        "properties": {
          "path": {"type": "string"},
          "url": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "restart_required": {"type": "boolean"}
        }
      }
    }
  }
}
